# Stage 1: Builder - Compila o binário Go
FROM public.ecr.aws/docker/library/golang:1.25-alpine AS builder

# Instalar dependências de build
RUN apk add --no-cache git ca-certificates

WORKDIR /app

# Copiar arquivos go mod e baixar dependências
COPY go.mod go.sum ./
RUN go mod download

# Copiar todo o código fonte
COPY . .

# Compilar o binário estático para ARM64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build \
    -ldflags="-w -s" \
    -o /app/api \
    ./cmd/api/main.go

# Verificar se o binário foi criado
RUN ls -lh /app/api

# Stage 2: Runtime - Imagem mínima para produção
FROM public.ecr.aws/docker/library/alpine:3.19

# Instalar ca-certificates para HTTPS
RUN apk add --no-cache ca-certificates

WORKDIR /app

# Copiar apenas o binário compilado do stage anterior
COPY --from=builder /app/api /app/api

# Expor porta
EXPOSE 8080

# Executar o binário diretamente
CMD ["/app/api"]
