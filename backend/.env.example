# Configurações do Banco de Dados
DB_HOST=postgres
DB_PORT=5432
DB_USER=solis_user
DB_PASSWORD=solis_password
DB_NAME=solis_db
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300
DB_CONN_MAX_IDLE_TIME=60

# Configurações do Servidor
SERVER_PORT=8080
SERVER_ENVIRONMENT=development

# Configurações de Segurança
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY_HOURS=1
JWT_REFRESH_TOKEN_EXPIRY_HOURS=24

# Configurações CORS
FRONTEND_URL=http://localhost:3500

# Configurações S3 (Opcional - para desenvolvimento local pode deixar vazio)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=solis-mkt-bucket
S3_PUBLIC_URL=https://solis-mkt-bucket.s3.us-east-1.amazonaws.com